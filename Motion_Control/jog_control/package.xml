<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jog_control</name>
  <version>0.1.0</version>
  <description>DSS 차량 수동 조작(jog) Qt5 GUI — /dss/control 발행</description>

  <maintainer email="kukwonko@gmail.com">amap</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <!-- DssControl.msg 사용 -->
  <depend>dss_ros2_bridge</depend>
  <!-- 수신 노드 실행 파일 경로 조회 (버튼 기동) -->
  <depend>ament_index_cpp</depend>
  <!-- Qt5 Widgets -->
  <depend>qtbase5-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
