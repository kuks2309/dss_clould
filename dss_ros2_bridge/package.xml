<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dss_ros2_bridge</name>
  <version>1.0.0</version>
  <description>DSS ROS2 Bridge</description>

  <maintainer email="bkkim2004@naver.com">bkkim</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>

  <!-- 영상 디코딩(JPEG) / protobuf 직렬화 / heartbeat JSON -->
  <depend>libopencv-dev</depend>
  <depend>protobuf-dev</depend>
  <depend>nlohmann-json-dev</depend>

  <!--
    cnats(libnats) 는 rosdep 키가 없어 여기에 선언할 수 없다.
    설치 절차는 README "2.1 필수 라이브러리 설치" 참조 (apt install libnats-dev).
  -->

  <!-- === 메시지 생성/사용을 위한 필수 의존성 === -->
  <!-- msg 파일 생성 -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- 빌드된 msg를 실행 환경에서 사용 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Lint — package format 3 스키마상 depend 계열이 member_of_group 보다 앞서야 한다 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 인터페이스 패키지 그룹 등록 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
